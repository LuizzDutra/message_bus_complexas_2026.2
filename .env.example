# Copie para .env e ajuste conforme necessario.
# INSTANCE_ID distingue cada instancia/conteiner nos testes entre instancias.
INSTANCE_ID=
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Barramento de eventos: "local" (default), "redis" ou "rabbitmq".
# Sem "local", suba o broker correspondente:
#   redis:    docker run -p 6379:6379 redis:7-alpine
#   rabbitmq: docker run -p 5672:5672 rabbitmq:4-management
BUS_BACKEND=local
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CHANNEL=complexas:ws
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/
RABBITMQ_EXCHANGE=complexas
RABBITMQ_QUEUE_PREFIX=complexas.
