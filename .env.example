# Copie para .env e ajuste conforme necessario.
# INSTANCE_ID distingue cada instancia/conteiner nos testes entre instancias.
INSTANCE_ID=
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Barramento de eventos: "local" (default) ou "redis".
# Com "redis", suba um Redis (ex.: docker run -p 6379:6379 redis:7-alpine).
BUS_BACKEND=local
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CHANNEL=complexas:ws
